# Load-bearing: keep the `!*` below. When this repository is cloned inside a parent folder whose .gitignore is `*`,
# Tailwind v4's scanner (which honours every .gitignore up the tree) would see no files here and emit no utilities: the
# pages would render unstyled while fonts and colours still look right. Re-including this tree prevents it;
# app/globals.css also names its sources with @source as a second guard.
!*

# dependencies
node_modules
.pnpm-store

# build output
.next
out
build
.turbo
*.tsbuildinfo
next-env.d.ts

# test + coverage
coverage
test-results

# secrets and local overrides — `.env.example` IS committed, real values never are
.env
.env*.local
*.local

# deployment
.vercel

# zz-meridian: an update in progress (its staged copies, backups and lock). .meridian/manifest.json, keep.json and
# history/ are committed: the next update reads them.
/.meridian/update/
/.meridian/update.lock

# agents: each person's own settings and runtime files. The skills under .claude/skills and .agents/skills are
# committed: they are the version of the skill that matches this project's Meridian, and update keeps them so.
/.claude/settings.local.json
/.claude/*.lock

# logs
*-debug.log*
*-error.log*

# editors and OS
.DS_Store
.idea
.vscode

