{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "newLine": "lf",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src"
  ]
}
