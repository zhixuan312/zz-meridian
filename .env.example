# The console's assistant: see the Assistant section of the README. It is off until the provider, the key and the model are set.
# Read on every request: no rebuild is needed to turn it on or off.

# "anthropic", or "openai-compatible" for OpenAI, OpenRouter, LiteLLM, Ollama and the like.
# ASSISTANT_PROVIDER=

# The provider's key. Required. The approval secret is derived from it.
# ASSISTANT_API_KEY=

# The model's id, as the provider names it. It must be able to call tools.
# A gateway (LiteLLM, OpenRouter and the like) often names models "<provider>.<model>": copy the id
# from the gateway's GET /models, and take it exactly as it comes — the prefix is part of the name.
# ASSISTANT_MODEL=

# The provider's address. Required for "openai-compatible"; optional for "anthropic".
# ASSISTANT_BASE_URL=
